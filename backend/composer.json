{
  "name": "pmml/hospital-backend",
  "version": "1.0.0",
  "description": "PMML Hospital Backend API",
  "require": {
    "php": ">=8.2",
    "mongodb/mongodb": "^2.2",
    "firebase/php-jwt": "^6.10",
    "cboden/ratchet": "^0.4.4",
    "bramus/router": "^1.6",
    "vlucas/phpdotenv": "^5.6",
    "mongodb/mongodb-extension": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "audit": {
      "ignore": ["PKSA-y2cr-5h3j-g3ys"],
