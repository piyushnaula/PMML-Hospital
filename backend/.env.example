# ═══════════════════════════════════════════════════════════════════
# PMML Hospital Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# On Render: set these in dashboard > Environment > Environment Variables.
# ═══════════════════════════════════════════════════════════════════

# ── MongoDB ──────────────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=pmml_hospital

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=86400

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use * for local dev. In production, set to your Vercel URL.
# Example: https://pmml-hospital.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=*

# ── WebSocket (internal) ────────────────────────────────────────
WS_PORT=8001
WS_TCP_PORT=8002
WS_INTERNAL_HOST=127.0.0.1

# ── Uploads ──────────────────────────────────────────────────────
UPLOAD_PATH=./uploads/certs/
