# ═══════════════════════════════════════════════════════════════════
# PMML Hospital Frontend — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env for local development.
# On Vercel: set these in Settings > Environment Variables.
# IMPORTANT: Vite requires the VITE_ prefix for client-side env vars.
# ═══════════════════════════════════════════════════════════════════

# ── Backend API URL ──────────────────────────────────────────────
# Local:      http://localhost:8000
# Production: https://your-backend-name.onrender.com
VITE_API_URL=http://localhost:8000

# ── WebSocket URL (optional) ────────────────────────────────────
# Leave empty to disable WebSocket (recommended for Render free tier).
# Local: ws://localhost:8001
# Production: wss://your-backend-ws.onrender.com (only if WS is exposed)
VITE_WS_URL=
